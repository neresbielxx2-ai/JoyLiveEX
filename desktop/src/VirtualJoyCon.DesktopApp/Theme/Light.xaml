<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Virtual Joy-Con light theme -->
    <Color x:Key="BgColor">#FFF2F3F7</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="CardColor">#FFE9EBF1</Color>
    <Color x:Key="AccentColor">#FF1976D2</Color>
    <Color x:Key="OkColor">#FF2E7D32</Color>
    <Color x:Key="WarnColor">#FFB26A00</Color>
    <Color x:Key="ErrColor">#FFC62828</Color>
    <Color x:Key="TextColor">#FF20232B</Color>
    <Color x:Key="MutedColor">#FF5C6373</Color>
    <Color x:Key="RailColor">#FFD3D7E0</Color>
    <Color x:Key="StickWellColor">#FFCFD4DE</Color>
    <Color x:Key="StickKnobColor">#FF8B93A5</Color>
    <Color x:Key="ButtonColor">#FFD6DAE4</Color>
    <Color x:Key="ButtonPressedColor">#FF1976D2</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Err" Color="{StaticResource ErrColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Rail" Color="{StaticResource RailColor}"/>
    <SolidColorBrush x:Key="StickWell" Color="{StaticResource StickWellColor}"/>
    <SolidColorBrush x:Key="StickKnob" Color="{StaticResource StickKnobColor}"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="{StaticResource ButtonColor}"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="{StaticResource ButtonPressedColor}"/>
</ResourceDictionary>
