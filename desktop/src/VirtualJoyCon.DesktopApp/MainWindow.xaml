<Window x:Class="VirtualJoyCon.DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIRTUAL JOY-CON — JoyLiveEX"
        Width="1240" Height="780" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Text}"
        UseLayoutRounding="True">
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Card}" Margin="0,0,10,0">
                    <Image x:Name="LogoImg" Width="26" Height="26"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VIRTUAL JOY-CON" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="dois controles virtuais · um Android · JoyLiveEX"
                               FontSize="11" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="FpsText" Text="" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource Muted}" FontSize="11"/>
                <TextBlock x:Name="VersionText" Text="v1.0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- ============ main ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <!-- connection card -->
                    <Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Desconectado" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                <RadioButton x:Name="ModeUsb" Content="USB" GroupName="mode" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="ModeInternet" Content="Internet" GroupName="mode" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="ModeLan" Content="LAN local" GroupName="mode" Margin="0,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                            </StackPanel>

                            <Button x:Name="ConnectButton" Content="Conectar dispositivo" Height="38" FontSize="14"
                                    FontWeight="SemiBold" Click="ConnectButton_Click" Margin="0,0,0,8"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Método:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MethodText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Text="Latência:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LatencyText" Text="-- ms" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Text="Perda de pacotes:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LossText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Text="Android:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DeviceText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Text="Serviço de controle:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ServiceText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Text="Modo de entrada:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InputModeText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="6" Text="Versão (app):" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="AndroidVerText" Text="—" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- pairing card -->
                    <Border x:Name="PairingCard" Background="{DynamicResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CÓDIGO DA SESSÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <Border Background="{DynamicResource Card}" CornerRadius="8" Padding="14,8">
                                    <TextBlock x:Name="PairCodeText" Text="--------" FontSize="26" FontWeight="Bold"
                                               FontFamily="Consolas" Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <Button Content="Copiar" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="CopyCode_Click"/>
                                <Button Content="Novo" Margin="6,0,0,0" VerticalAlignment="Bottom" Click="NewCode_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="PairHintText" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Muted}"
                                       Text="No celular, abra o Virtual Joy-Con → INTERNET → digite o código."/>
                        </StackPanel>
                    </Border>

                    <!-- control card -->
                    <Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Button x:Name="StartStopButton" Content="INICIAR CONTROLE" Height="42" FontSize="15"
                                    FontWeight="Bold" Click="StartStop_Click" Background="{DynamicResource Card}"/>
                            <Button x:Name="SettingsButton" Content="CONFIGURAÇÕES" Height="34" FontSize="13"
                                    Margin="0,8,0,0" Click="Settings_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- adb / diagnostics card (spec §8) -->
                    <Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DIAGNÓSTICO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="ADB:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AdbText" Text="VERIFICANDO…" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Text="Device:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AdbDeviceText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Text="Transport:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TransportText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Text="Daemon:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DaemonText" Text="—" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Text="Gamepad PC:" Foreground="{DynamicResource Muted}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PadText" Text="nenhum" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- controller -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="12" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="ControllerHost" Grid.Row="0" Margin="18,10,18,2"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <TextBlock Grid.Row="1" x:Name="ControllerHint" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource Muted}" Margin="18,6,18,10"
                               Text="Mouse ou touch: clique e segure nos botões, arraste os analógicos. Teclado: W A S D (stick), J K U I (A/B/X/Y), Q/E (ZL/ZR), 1/2 (L/R), Enter/Backspace (+/−) — tudo remapeável. F9 liga/desliga o envio."/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ log ============ -->
        <Expander Grid.Row="2" Header="Log de eventos" FontSize="12" Foreground="{DynamicResource Text}"
                  Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Rail}" Margin="0,10,0,0" IsExpanded="False">
            <Grid Height="150" Margin="6,6,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LogList" Grid.Column="0" FontFamily="Consolas" FontSize="11"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="Limpar" FontSize="11" Click="ClearLog_Click" Margin="0,0,0,6"/>
                    <Button Content="Abrir pasta" FontSize="11" Click="OpenLog_Click"/>
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</Window>
